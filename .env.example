# ==============================================================================
# Lamarin - Personal Job Application Mailer
# Environment Variables Configuration
# ==============================================================================
# Petunjuk:
# Salin file ini menjadi .env.local untuk pengembangan lokal:
#   cp .env.example .env.local
# Untuk deployment Vercel, masukkan variabel di bawah ini ke menu:
#   Project Settings -> Environment Variables
# ==============================================================================

# Supabase URL & Public Anon Key
# Didapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Rahasia server-side)
# Didapatkan dari: Supabase Dashboard -> Project Settings -> API (Service Role Secret)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL Aplikasi (digunakan untuk callback OAuth)
# Contoh lokal: http://localhost:3000
# Contoh production: https://namaproject.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gmail API OAuth 2.0 Credentials (Rahasia server-side)
# Scope: https://www.googleapis.com/auth/gmail.send
# Didapatkan dari: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Kunci Enkripsi Token Gmail (AES-256-GCM)
# String rahasia minimal 32 karakter acak (atau 64 karakter hex)
# Digunakan untuk mengenkripsi refresh token sebelum disimpan ke database
GMAIL_TOKEN_ENCRYPTION_KEY=
